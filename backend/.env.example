# Copy this file to .env and add your own key to enable Gemini features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SQLITE_PATH=finpilot.db
# Comma-separated frontend origins; add your deployed frontend origin here.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
APP_LOGIN_USERNAME=demo
APP_LOGIN_PASSWORD=change-this-before-first-run
SESSION_SECRET=
